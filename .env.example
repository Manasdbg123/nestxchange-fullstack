# ---------------------------------------------------------------------------
# NestXchange - environment configuration
# Copy to `.env` and fill in real values. NEVER commit the populated `.env`.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# --- Database --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/nestxchange
DB_USERNAME=nestxchange
DB_PASSWORD=change-me
POSTGRES_DB=nestxchange

# --- JWT -------------------------------------------------------------------
# Must be at least 64 bytes for HS512. Generate one with:
#   openssl rand -base64 96
JWT_SECRET=replace-with-a-64-byte-or-longer-random-string-do-not-use-this-value
JWT_EXPIRATION_MS=86400000

# --- Cloudinary (image hosting) -------------------------------------------
# Leave blank to run with the no-op local image store instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Seeding ---------------------------------------------------------------
# Only honoured under the `dev` profile.
SEED_ENABLED=true
SEED_ADMIN_EMAIL=admin@nestxchange.local
SEED_ADMIN_PASSWORD=change-me-too
