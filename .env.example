# ---------------------------------------------------------------------------
# NestXchange - environment configuration
# Copy to `.env` and fill in real values. NEVER commit the populated `.env`.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# --- Database --------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/nestxchange
DB_USERNAME=nestxchange
DB_PASSWORD=change-me
POSTGRES_DB=nestxchange

# --- JWT -------------------------------------------------------------------
# Must be at least 64 bytes for HS512. Generate one with:
#   openssl rand -base64 96
JWT_SECRET=replace-with-a-64-byte-or-longer-random-string-do-not-use-this-value
JWT_EXPIRATION_MS=86400000

# --- Cloudinary (image hosting) -------------------------------------------
# Leave blank to run with the no-op local image store instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- AI assistant (Groq, OpenAI-compatible) --------------------------------
# Leave blank to disable the assistant widget instead of erroring.
ASSISTANT_API_KEY=

# --- Password reset email (Resend) ------------------------------------------
# Leave blank to log reset emails instead of sending them (fine for local dev).
RESEND_API_KEY=
EMAIL_FROM=NestXchange <onboarding@resend.dev>
# Where a password-reset email's link should point - your deployed frontend.
APP_FRONTEND_URL=http://localhost:5173

# --- Rate limiting -----------------------------------------------------------
# Applies to /auth/login, /auth/register, /auth/forgot-password, /auth/reset-password.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=300
